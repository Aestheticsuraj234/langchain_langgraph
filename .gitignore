gitignore# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt string build cache
.grunt

# Bower dependency directory (if using Bower)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org)
build/Release

# Dependency directories for TypeScript
jspm_packages/

# TypeScript cache
.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.microbundle

# Optional REPL history
.node_repl_history

# Output directory from erase/build scripts
dist/
out/

# IDEs and editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system files
.DS_Store
Thumbs.db

# Environment variables and secrets (NEVER commit these!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env